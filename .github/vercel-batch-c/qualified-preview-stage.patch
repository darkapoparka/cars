+import { createHash } from 'node:crypto';
+import { assertNativeQualification, NATIVE_PACKAGING_VERSION } from '../lib/native-localization.mjs';
+import { baseNativeManifest, APP_PACKAGING_VERSION } from './app-variant.mjs';
+import { applyNativeMounts } from './native-mounts.mjs';
+import { assertVercelQualificationExport } from '../export-dealer.mjs';
+
+const requireStage = (value, message) => { if (!value) throw new Error('Vercel qualified preview: ' + message); };
+const hash = value => createHash('sha256').update(value).digest('hex');
+
+/** Use the existing native-source seal and mount adapters; never grant release acceptance.
+ * Ordinary package/export paths remain separate and still reject provisional sources.
+ */
+export function prepareVercelQualifiedSource({ files, manifest, sourceCommit, request, nativeReleases, provider, root }) {
+  requireStage(provider === 'vercel' && [NATIVE_PACKAGING_VERSION, APP_PACKAGING_VERSION, '5'].includes(manifest.packaging?.version), 'native Vercel packaging is required');
+  requireStage(nativeReleases === undefined, 'approved releases cannot be mixed with a qualification request');
+  requireStage(request?.schemaVersion === 1 && request.kind === 'cars-vercel-qualified-preview-request' && request.reviewed === true, 'an explicit reviewed preview request is required');
+  requireStage(request.provider === 'vercel' && request.production === false && request.nativeApproval === false && request.hostedApproval === false && request.globalReleaseApproval === false, 'a preview request cannot claim production or release approval');
+  requireStage(request.dealer === manifest.slug && request.repository === manifest.repository && request.sourceCommit === sourceCommit && /^[a-f0-9]{40}$/.test(sourceCommit), 'dealer, repository and exact source commit must match');
+  requireStage(typeof request.publicOrigin === 'string' && request.publicOrigin === manifest.shareIdentity?.publicOrigin, 'the registered stable origin must match the dealer');
+  const origin = new URL(request.publicOrigin);
+  requireStage(origin.protocol === 'https:' && !origin.username && !origin.password && origin.pathname === '/' && !origin.search && !origin.hash, 'a plain HTTPS origin is required');
+  requireStage(/^prj_[A-Za-z0-9]+$/.test(request.projectId || ''), 'the existing project ID must be recorded');
+  requireStage(/^codex\/[a-z0-9][a-z0-9/-]*$/.test(request.targetBranch || '') && !request.targetBranch.includes('..') && !request.targetBranch.endsWith('/'), 'the exact codex preview branch is required');
+  const adoptionBytes = files.get('localization/adoption.json');
+  requireStage(Buffer.isBuffer(adoptionBytes), 'the actual source qualification receipt is required');
+  const candidate = JSON.parse(adoptionBytes.toString('utf8'));
+  requireStage(request.sourceAdoptionSha256 === hash(adoptionBytes), 'the request must bind the exact source adoption bytes');
+  const base = baseNativeManifest(manifest);
+  const before = assertNativeQualification(files, base, candidate.context, { root });
+  requireStage(request.nativeInputDigest === before.input.digest && request.nativeInputFiles === before.input.files, 'the request must bind the actual native input');
+  const mounted = applyNativeMounts(files, base);
+  const after = assertNativeQualification(mounted, base, candidate.context, { root });
+  requireStage(after.input.digest === before.input.digest && after.input.files === before.input.files, 'mounting changed the reviewed qualified source; reconcile upstream');
+  const qualification = {
+    schemaVersion: 1, kind: 'cars-vercel-native-source-qualification', provider,
+    dealer: manifest.slug, repository: manifest.repository, publicOrigin: request.publicOrigin,
+    projectId: request.projectId, targetBranch: request.targetBranch, sourceCommit,
+    sourceAdoptionSha256: hash(adoptionBytes), input: before.input, contextDigest: before.contextDigest,
+    requestSha256: hash(JSON.stringify(request)),
+    production: false, nativeApproval: false, hostedApproval: false, globalReleaseApproval: false,
+    pendingNativeChecks: before.pendingNativeChecks
+  };
+  assertVercelQualificationExport({ qualification, sourceCommit, assetDelivery: { provider } }, { branch: request.targetBranch, manifest });
+  return { files: mounted, qualification };
+}
