{
  "schemaVersion": 2,
  "workingBranch": "main",
  "repositories": [
    {
      "key": "cars",
      "name": "Cars - templates and dealer tools",
      "path": ".",
      "repository": "darkapoparka/cars",
      "role": "integration"
    },
    {
      "key": "admin",
      "name": "Cars Admin - shared public demo",
      "path": "../cars-admin",
      "repository": "darkapoparka/cars-admin",
      "role": "admin-demo"
    }
  ],
  "adminDemo": {
    "url": "https://cars-admin-blue.vercel.app/",
    "projectId": "prj_wT1EN9RKpyy4WiKJRuD38KWpRRgW",
    "mode": "synthetic-browser-local"
  },
  "scratch": "runtime/",
  "registry": "docs/DEPLOYMENT-INVENTORY.json",
  "machinePaths": {
    "win32": "L:/CODEX/cars"
  },
  "independentClientsRoot": {
    "win32": "L:/CODEX/cars/clients"
  },
  "templates": [
    {
      "key": "auto-best",
      "name": "Template - Auto Best",
      "path": "templates/auto-best",
      "repository": "darkapoparka/cars",
      "role": "template-master"
    },
    {
      "key": "modern",
      "name": "Template - Modern",
      "path": "templates/modern",
      "repository": "darkapoparka/cars",
      "role": "template-master"
    },
    {
      "key": "carwow",
      "name": "Template - Carwow",
      "path": "templates/carwow",
      "repository": "darkapoparka/cars",
      "role": "template-master"
    },
    {
      "key": "import",
      "name": "Template - Import",
      "path": "templates/import",
      "repository": "darkapoparka/cars",
      "role": "template-master"
    }
  ],
  "agencyOS": {
    "workspace": "L:/CODEX/agency",
    "controlProject": "L:/CODEX/agency/os",
    "repository": "darkapoparka/agenzy",
    "relationship": "independent-automotive-delivery-module",
    "integration": "workspace-navigation-only; CRM/runtime integration is not changed"
  }
}
