{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "ES2022",
    "noEmit": false,
    "incremental": false,
    "rootDir": ".",
    "outDir": "runtime/unit-tests",
    "plugins": []
  },
  "include": [
    "tests/**/*.test.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
