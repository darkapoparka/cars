{
  "name": "cars-template-noir",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.17"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "stock": "node scripts/import-stock.mjs",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "format": "prettier --write src scripts *.ts *.json",
    "format:check": "prettier --check src scripts *.ts *.json",
    "prepare": "svelte-kit sync"
  },
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "4.0.1",
    "@sveltejs/kit": "3.0.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "25.5.0",
    "prettier": "3.8.1",
    "prettier-plugin-svelte": "3.4.1",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vite": "8.3.3"
  }
}
