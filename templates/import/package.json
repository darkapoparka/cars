{
	"name": "cars-template-import",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "npm run lint:format && npm run lint:code",
		"format": "prettier --write .",
		"verify": "npm run check && npm run lint && npm run check:architecture && npm run check:assets && npm run test:unit -- --run",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"lint:format": "prettier --check .",
		"lint:code": "eslint .",
		"verify:static": "npm run check && npm run lint && npm run test:unit -- --run",
		"test:e2e:list": "playwright test --list",
		"check:architecture": "node scripts/check-architecture.mjs",
		"check:assets": "node scripts/check-assets.mjs"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@eslint/compat": "^2.0.4",
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/geist": "^5.2.9",
		"@playwright/test": "^1.59.1",
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/vite": "^4.2.2",
		"@types/node": "^24",
		"drizzle-kit": "0.31.10",
		"eslint": "^10.2.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.17.0",
		"globals": "^17.4.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"shadcn-svelte": "^1.3.0",
		"sharp": "^0.35.4",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"tailwindcss": "^4.2.2",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.1",
		"vite": "^8.0.7",
		"vitest": "^4.1.3"
	},
	"dependencies": {
		"@ai-sdk/openai": "^3.0.68",
		"@ai-sdk/svelte": "^4.0.197",
		"@hugeicons/core-free-icons": "4.3.2",
		"@hugeicons/svelte": "1.1.5",
		"@lucide/svelte": "^1.17.0",
		"@neondatabase/serverless": "1.1.0",
		"ai": "^6.0.197",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"drizzle-orm": "0.45.2",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.2.2",
		"vaul-svelte": "^1.0.0-next.7",
		"zod": "^4.4.3"
	},
	"engines": {
		"node": ">=24.12.0 <25"
	},
	"packageManager": "npm@11.19.0"
}
