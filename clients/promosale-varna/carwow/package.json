{
  "name": "promosale-varna-carwow",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 6762 --strictPort",
    "build": "vite build",
    "build:deploy": "npm run check:backend-env && vite build",
    "build:preview-node": "node scripts/build-node-preview.mjs",
    "preview": "vite preview",
    "preview:node": "node scripts/preview-node.mjs",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && node ./node_modules/svelte-check/bin/svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && node ./node_modules/svelte-check/bin/svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && node ./node_modules/eslint/bin/eslint.js .",
    "format": "prettier --write .",
    "check:schema-drift": "node scripts/check-neon-schema-drift.mjs",
    "clean:workspace": "node scripts/clean-workspace.mjs",
    "audit:assets": "node scripts/static-asset-budget.mjs --strict",
    "audit:desktop-weight": "node scripts/desktop-prod-weight.mjs --strict",
    "audit:desktop-weight:target": "node scripts/desktop-prod-weight.mjs --target-strict",
    "audit:mobile-weight": "node scripts/mobile-prod-weight-all.mjs",
    "audit:template-assets": "node scripts/template-asset-manifest.mjs",
    "visual:baseline": "playwright test -c playwright.visual.config.ts --update-snapshots",
    "visual:verify": "playwright test -c playwright.visual.config.ts",
    "visual:smoke": "node scripts/visual-parity.mjs --mode=verify",
    "test:home-runtime": "node scripts/home-runtime-smoke.mjs",
    "check:backend-env": "node scripts/backend-env-preflight.mjs",
    "check:backend-secrets": "node scripts/backend-secret-boundary.mjs",
    "smoke:backend": "node scripts/backend-launch-smoke.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/neon-migrate.mjs",
    "db:studio": "drizzle-kit studio",
    "neon:seed": "node scripts/seed-neon-demo.mjs",
    "neon:link-admin": "node scripts/link-neon-admin-user.mjs",
    "neon:export": "node scripts/neon-data-export.mjs",
    "neon:import": "node scripts/neon-data-import.mjs",
    "test:unit": "vitest",
    "test": "npm run test:unit -- --run && npm run test:e2e",
    "test:e2e": "playwright install && playwright test"
  },
  "devDependencies": {
    "@eslint/compat": "^2.0.4",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/geist": "^5.2.9",
    "@internationalized/date": "^3.12.2",
    "@lucide/svelte": "^1.17.0",
    "@playwright/test": "^1.59.1",
    "@sveltejs/adapter-node": "^5.5.4",
    "@sveltejs/adapter-vercel": "^6.3.3",
    "@sveltejs/kit": "^2.57.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^24",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.17.0",
    "globals": "^17.4.0",
    "pg": "^8.21.0",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.5.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "shadcn-svelte": "^1.3.0",
    "sharp": "^0.35.1",
    "svelte": "^5.55.2",
    "svelte-check": "^4.4.6",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.1",
    "vaul-svelte": "^1.0.0-next.7",
    "vite": "^8.0.16",
    "vitest": "^4.1.3"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.68",
    "@ai-sdk/svelte": "^4.0.197",
    "@better-auth/drizzle-adapter": "^1.6.19",
    "@neondatabase/serverless": "^1.1.0",
    "ai": "^6.0.197",
    "better-auth": "^1.6.19",
    "bits-ui": "^2.18.1",
    "drizzle-orm": "^0.45.2",
    "zod": "^4.4.3"
  },
  "overrides": {
    "cookie": "0.7.2",
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.4"
    }
  }
}
