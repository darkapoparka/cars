    "../carwow/src/lib/data/daynight-vehicles.ts",
    "../carwow/src/lib/data/daynight-faq.ts",
    "../carwow/src/lib/data/daynight-reviews.ts",
    "../carwow/src/lib/server/public-routes.ts",
    "../carwow/src/lib/server/daynight-seo.ts"
  ]
}
