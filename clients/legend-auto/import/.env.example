# Leave blank for the synthetic, in-memory template preview.
DATABASE_URL=
# Direct Neon connection (no -pooler hostname) for npm run db:migrate.
DATABASE_URL_UNPOOLED=
# Required to access durable inquiries at /admin/login. Use unique private values.
TEMPLATE_ADMIN_EMAIL=
# At least 16 characters. Never copy these credentials into a dealer's environment.
TEMPLATE_ADMIN_PASSWORD=
