# Leave empty for a standalone site. Set before building mounted previews.
NEXT_PUBLIC_BASE_PATH=
# Optional isolated build output; normal development uses .next.
# NEXT_DIST_DIR=.next-review
# Mounted Cars previews load a host-provided /preview-switcher.js.
# Set to 0 for a standalone mounted site without that host integration.
# CARS_PREVIEW_SWITCHER=0
