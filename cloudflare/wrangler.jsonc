{
  "name": "cars-uk-dewsbury-car-market-yorkshire",
  "main": "router.mjs",
  "compatibility_date": "2026-10-10",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": false
  },
  "services": [
    {
      "binding": "CARS_AUTO_BEST",
      "service": "cars-uk-dewsbury-car-market-yorkshire-auto-best"
    },
    {
      "binding": "CARS_MODERN",
      "service": "cars-uk-dewsbury-car-market-yorkshire-modern"
    },
    {
      "binding": "CARS_IMPORT",
      "service": "cars-uk-dewsbury-car-market-yorkshire-import"
    },
    {
      "binding": "CARS_APP",
      "service": "cars-uk-dewsbury-car-market-yorkshire-app"
    },
    {
      "binding": "CARS_MOBILE",
      "service": "cars-uk-dewsbury-car-market-yorkshire-mobile"
    },
    {
      "binding": "CARS_KARENTO_BEST",
      "service": "cars-uk-dewsbury-car-market-yorkshire-signature"
    }
  ]
}
